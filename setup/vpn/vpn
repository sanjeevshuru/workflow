#!/bin/bash
# vpn: connect the company VPN through FortiClient, with nobody clicking.
#
#   vpn up           connect: VPN Connect.app clicks SAML Login in FortiClient; the Microsoft
#                    sign-in then completes in the browser (by itself if you're already signed in)
#   vpn down         disconnect (clicks Disconnect)
#   vpn check        is the GitLab host reachable? (no UI; exit 0 when reachable)
#   vpn status       FortiClient's state and GitLab reachability
#   vpn setup-check  is VPN Connect.app built and allowed under Accessibility?
#   vpn dump         list FortiClient's on-screen labels (to adapt to a new FortiClient version)
#
# Runs straight from the repo (setup/vpn/vpn); no admin, no install beyond the applet
# (setup/vpn/install-applet.sh). Exit codes: 0 ok · 1 failed / not reachable ·
# 2 FortiClient connected but GitLab unreachable · 3 applet missing or not allowed · 64 usage.
#
# The FORTIVPN_* variables exist for the test suite (setup/vpn/tests/run-tests.sh).

set -u

APP="${FORTIVPN_APPLET:-$HOME/Applications/VPN Connect.app}"
STATE="${FORTIVPN_STATE:-$HOME/Library/Caches/vpn-connect}"
PROBE_HOST="${FORTIVPN_PROBE_HOST:-jcvs.japfacomfeed.co.id}"
PROBE_PORT="${FORTIVPN_PROBE_PORT:-443}"
TIMEOUT="${FORTIVPN_TIMEOUT:-180}"
APPLET_WAIT="${FORTIVPN_APPLET_WAIT:-45}"
DOWN_WAIT="${FORTIVPN_DOWN_WAIT:-20}"
PATH="${FORTIVPN_PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
export PATH

say() { printf 'vpn: %s\n' "$*"; }
err() { printf 'vpn: %s\n' "$*" >&2; }

reachable() { nc -z -G 5 "$PROBE_HOST" "$PROBE_PORT" >/dev/null 2>&1; }

wait_until() { # wait_until <seconds> <reachable|unreachable>
  local i=0
  while [ "$i" -lt "$1" ]; do
    if [ "$2" = reachable ]; then reachable && return 0; else reachable || return 0; fi
    sleep 1; i=$((i + 1))
  done
  return 1
}

# Runs one applet request and prints its result. Exit 3 if the applet is missing or not allowed.
applet() {
  local req="$1" i=0 out
  if [ ! -d "$APP" ]; then
    err "$APP is missing: run setup/vpn/install-applet.sh (once, no admin)"
    return 3
  fi
  mkdir -p "$STATE"
  if ! mkdir "$STATE/lock" 2>/dev/null; then
    # A lock older than 2 minutes is left over from a crash.
    if [ -n "$(find "$STATE/lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then rmdir "$STATE/lock" 2>/dev/null; fi
    mkdir "$STATE/lock" 2>/dev/null || { err "another vpn command is running"; return 1; }
  fi
  rm -f "$STATE/result"
  printf '%s\n' "$req" >"$STATE/request"
  if ! open -g "$APP" >/dev/null 2>&1; then
    rmdir "$STATE/lock"; err "could not launch $APP"; return 1
  fi
  while [ ! -s "$STATE/result" ] && [ "$i" -lt $((APPLET_WAIT * 4)) ]; do sleep 0.25; i=$((i + 1)); done
  rm -f "$STATE/request"; rmdir "$STATE/lock" 2>/dev/null
  if [ ! -s "$STATE/result" ]; then
    err "VPN Connect.app didn't answer within ${APPLET_WAIT}s"
    return 1
  fi
  out=$(cat "$STATE/result")
  printf '%s\n' "$out"
  case "$out" in
    "error: not allowed"*) return 3 ;;
    error:*) return 1 ;;
  esac
  return 0
}

cmd_check() {
  if reachable; then say "$PROBE_HOST: reachable"; return 0; fi
  say "$PROBE_HOST: unreachable"; return 1
}

cmd_up() {
  local out rc
  if reachable; then say "already connected: $PROBE_HOST reachable"; return 0; fi
  out=$(applet connect); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/vpn: FortiClient: /'
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 3 ] && err "one-time setup: setup/vpn/install-applet.sh, then allow 'VPN Connect' under Accessibility"
    return "$rc"
  fi
  case "$out" in
    *"already connected"*)
      if wait_until 10 reachable; then say "connected: $PROBE_HOST reachable"; return 0; fi
      err "FortiClient says connected but $PROBE_HOST is unreachable (DNS or routes; see setup/vpn.md → Troubleshooting)"
      return 2 ;;
  esac
  say "waiting for the Microsoft sign-in in your browser (up to ${TIMEOUT}s)"
  if wait_until "$TIMEOUT" reachable; then say "connected: $PROBE_HOST reachable"; return 0; fi
  err "not connected after ${TIMEOUT}s: finish the sign-in in the browser, or check FortiClient"
  return 1
}

cmd_down() {
  local out rc
  out=$(applet disconnect); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/vpn: FortiClient: /'
  [ "$rc" -eq 0 ] || return "$rc"
  if wait_until "$DOWN_WAIT" unreachable; then say "disconnected"; return 0; fi
  err "$PROBE_HOST is still reachable (another VPN or network path?)"
  return 1
}

cmd_status() {
  local out rc
  out=$(applet status); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/vpn: FortiClient: /'
  if reachable; then say "$PROBE_HOST: reachable"; return 0; fi
  say "$PROBE_HOST: unreachable"
  [ "$rc" -eq 3 ] && return 3
  return 1
}

cmd_setup_check() {
  local out rc
  out=$(applet check); rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/vpn: /'
  if [ "$rc" -eq 0 ]; then say "setup OK"; fi
  return "$rc"
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  check) cmd_check ;;
  status) cmd_status ;;
  setup-check) cmd_setup_check ;;
  dump) applet dump ;;
  *) echo "usage: vpn up|down|check|status|setup-check|dump" >&2; exit 64 ;;
esac
