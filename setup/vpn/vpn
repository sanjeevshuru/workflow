#!/bin/bash
# vpn: start, stop and check the FortiGate SSL VPN (SAML sign-in) through openfortivpn.
#
#   vpn up       connect; opens the Microsoft sign-in in the browser (no typing if already signed in)
#   vpn down     disconnect
#   vpn status   connected | connecting | disconnected   (exit 0 only when the tunnel is up)
#   vpn check    is the internal probe host reachable, through any VPN   (exit 0 when reachable)
#   vpn log      last 40 lines of the VPN log
#   vpn installed  is the one-time install in place? (exit 3 with the command to run if not)
#
# Installed to /usr/local/bin/vpn by setup/vpn/install.sh. The only root actions are
# `launchctl kickstart` / `launchctl kill SIGTERM` of the local.fortivpn daemon, which the
# sudoers rule allows without a password and nothing else.
#
# Exit codes: 0 ok · 1 failed / not connected · 2 tunnel up but probe host unreachable (DNS)
#             3 not installed or not allowed · 64 usage
#
# The FORTIVPN_* variables exist for the test suite (setup/vpn/tests/run-tests.sh). This script
# runs as the user, so overriding them never grants anything the sudoers rule doesn't.

set -u

LABEL="local.fortivpn"
CONF="${FORTIVPN_CONF:-/etc/openfortivpn/work.conf}"
LOG="${FORTIVPN_LOG:-/var/log/fortivpn.log}"
PROBE_HOST="${FORTIVPN_PROBE_HOST:-jcvs.japfacomfeed.co.id}"
PROBE_PORT="${FORTIVPN_PROBE_PORT:-443}"
TIMEOUT="${FORTIVPN_TIMEOUT:-180}"
START_WAIT="${FORTIVPN_START_WAIT:-15}"
# Focus: the sign-in page opens in a background browser tab (`open -g`), so you stay in your app;
# with a Microsoft session it completes by itself. Only if the tunnel isn't up after SIGNIN_GRACE
# seconds is the browser brought forward, for you to sign in. FORTIVPN_KEEP_FOCUS=0: open it in front.
KEEP_FOCUS="${FORTIVPN_KEEP_FOCUS:-1}"
SIGNIN_GRACE="${FORTIVPN_SIGNIN_GRACE:-25}"
HERE=$(cd "$(dirname "$0")" && pwd)
INSTALL_ROOT="${FORTIVPN_ROOT:-}"   # test suite only: where to look for the installed files
FORTICLIENT_APP="${FORTIVPN_FORTICLIENT_APP:-/Applications/FortiClient.app}"
PATH="${FORTIVPN_PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
export PATH

say() { printf 'vpn: %s\n' "$*"; }
err() { printf 'vpn: %s\n' "$*" >&2; }

running() { pgrep -x openfortivpn >/dev/null 2>&1; }

ppp_iface() { ifconfig -l 2>/dev/null | tr ' ' '\n' | grep '^ppp' | head -n 1; }

reachable() { nc -z -G 5 "$PROBE_HOST" "$PROBE_PORT" >/dev/null 2>&1; }

state() {
  if running; then
    if [ -n "$(ppp_iface)" ]; then echo connected; else echo connecting; fi
  else
    echo disconnected
  fi
}

log_size() {
  if [ -r "$LOG" ]; then wc -c <"$LOG" | tr -d ' '; else echo 0; fi
}

# Log text written after byte offset $1.
log_since() { [ -r "$LOG" ] && tail -c +"$(($1 + 1))" "$LOG" 2>/dev/null; }

# Byte offset where the latest session's SAML wait started (used when re-attaching).
last_session_offset() {
  [ -r "$LOG" ] || { echo 0; return; }
  local off
  off=$(grep -b 'Listening for SAML login' "$LOG" 2>/dev/null | tail -n 1 | cut -d: -f1)
  echo "${off:-0}"
}

conf_value() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null | tail -n 1; }

fallback_saml_url() {
  local host port realm
  host=$(conf_value host); port=$(conf_value port); realm=$(conf_value realm)
  [ -n "$host" ] || return 1
  printf 'https://%s:%s/remote/saml/start?redirect=1%s\n' "$host" "${port:-443}" "${realm:+&realm=$realm}"
}

# Bundle id of the default https browser (LaunchServices), e.g. com.google.chrome.
default_browser() {
  defaults read com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers 2>/dev/null \
    | awk '/LSHandlerRoleAll/ { id = $3 } /LSHandlerURLScheme = https;/ { gsub(/[";]/, "", id); print id; exit }'
}

# Bundle id of the frontmost app (no permission needed), or nothing.
front_app() {
  lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
    | sed -n 's/.*[Bb]undle[A-Za-z]*"*="\([^"]*\)".*/\1/p' | head -n 1
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Background: Chrome comes forward even for `open -g`. While the sign-in should be completing by
# itself, switch back to <app> whenever <browser> takes the front. Stopped by cmd_up.
focus_guard() { # focus_guard <app> <browser> <seconds>
  local end cur
  end=$(( $(date +%s) + $3 ))
  while [ "$(date +%s)" -lt "$end" ]; do
    cur=$(front_app)
    [ -n "$cur" ] && [ "$(lower "$cur")" = "$(lower "$2")" ] && open -b "$1" >/dev/null 2>&1
    sleep 0.3
  done
}

stop_guard() { [ -n "${guard:-}" ] && kill "$guard" 2>/dev/null; guard=""; }

show_log_tail() {
  if [ -r "$LOG" ]; then
    err "last log lines ($LOG):"
    log_since "$1" | tail -n 20 | sed 's/^/    /' >&2
  else
    err "log $LOG is not readable"
  fi
}

priv() { sudo -n launchctl "$@" "system/$LABEL"; }

stop_daemon() {
  priv kill SIGTERM >/dev/null 2>&1 || return 1
  local i=0
  while running && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done
  ! running
}

# Is the one-time install (setup/vpn/install.sh) in place and active? Exit 0, or 3 with what's
# missing and the command to fix it.
cmd_installed() {
  local R="$INSTALL_ROOT" missing=0 ofv=""
  check_item() { # check_item <label> <test...>
    local label="$1"; shift
    if "$@"; then say "ok       $label"; else say "MISSING  $label"; missing=1; fi
  }
  rule_active() { sudo -n -l 2>/dev/null | grep -q "system/$LABEL"; }
  check_item "VPN client (root-owned copy)    /usr/local/libexec/fortivpn/openfortivpn" test -x "$R/usr/local/libexec/fortivpn/openfortivpn"
  check_item "gateway config                  /etc/openfortivpn/work.conf" test -r "$R/etc/openfortivpn/work.conf"
  check_item "on-demand daemon                /Library/LaunchDaemons/$LABEL.plist" test -e "$R/Library/LaunchDaemons/$LABEL.plist"
  check_item "passwordless start/stop rule    /etc/sudoers.d/fortivpn" test -e "$R/etc/sudoers.d/fortivpn"
  check_item "  … active for $(id -un)" rule_active
  check_item "VPN log readable                $LOG" test -r "$R$LOG"
  [ "$missing" -eq 0 ] && { say "installed"; return 0; }

  for c in /opt/homebrew/bin/openfortivpn /usr/local/bin/openfortivpn "$HOME/homebrew/bin/openfortivpn"; do
    [ -x "$c" ] && { ofv="$c"; break; }
  done
  err "not installed. Once, in your own terminal (sudo asks for your password once; no AI agent can type it):"
  [ -n "$ofv" ] || err "    brew install openfortivpn"
  if [ -x "$HERE/install.sh" ]; then
    err "    sudo \"$HERE/install.sh\" --user \"$(id -un)\""
  else
    err "    sudo setup/vpn/install.sh --user \"$(id -un)\"     (from the workflow folder)"
  fi
  err "then run: vpn up"
  return 3
}

cmd_status() {
  local s iface
  s=$(state); iface=$(ppp_iface)
  if [ "$s" = connected ]; then say "connected (${iface})"; else say "$s"; fi
  if reachable; then say "$PROBE_HOST: reachable"; else say "$PROBE_HOST: unreachable"; fi
  [ "$s" = connected ]
}

cmd_check() {
  if reachable; then say "$PROBE_HOST: reachable"; return 0; fi
  say "$PROBE_HOST: unreachable"; return 1
}

cmd_up() {
  local s offset url i b orig=""
  guard=""
  s=$(state)
  if [ "$s" = connected ]; then say "already connected ($(ppp_iface))"; return 0; fi
  if [ "$s" = disconnected ] && reachable; then
    say "$PROBE_HOST is already reachable through another VPN (FortiClient?); not starting openfortivpn"
    return 0
  fi
  [ -r "$LOG" ] || err "warning: cannot read $LOG; progress can't be followed (re-run setup/vpn/install.sh)"

  if [ "$s" = connecting ]; then
    say "a connection is already waiting for the sign-in; reopening the browser"
    offset=$(last_session_offset)
  else
    offset=$(log_size)
    if ! priv kickstart >/dev/null 2>&1; then
      err "can't start the VPN daemon without a password:"
      cmd_installed >&2
      return 3
    fi
  fi

  # Wait until openfortivpn listens on 127.0.0.1:8020. It logs "Listening for SAML login"; the
  # "Using SAML authentication URL" line only appears in verbose builds, so the URL is otherwise
  # built from work.conf in openfortivpn's own format.
  url=""; i=0
  while [ "$i" -lt "$START_WAIT" ]; do
    url=$(log_since "$offset" | sed -n 's/.*Using SAML authentication URL //p' | tail -n 1)
    [ -n "$url" ] && break
    if log_since "$offset" | grep -q 'Listening for SAML login'; then
      url=$(fallback_saml_url) && break
    fi
    if ! running && [ "$i" -ge 2 ]; then
      err "openfortivpn exited before the sign-in started"
      show_log_tail "$offset"; return 1
    fi
    sleep 1; i=$((i + 1))
  done
  if [ -z "$url" ]; then
    url=$(fallback_saml_url) || { err "no SAML URL in the log and no host in $CONF"; stop_daemon; return 1; }
    err "warning: openfortivpn didn't report it was listening; trying $url anyway"
  fi

  if [ "$KEEP_FOCUS" = 1 ]; then
    orig=$(front_app); b=$(default_browser)
    if [ -n "$orig" ] && [ -n "$b" ] && [ "$(lower "$orig")" != "$(lower "$b")" ]; then
      focus_guard "$orig" "$b" "$SIGNIN_GRACE" >/dev/null 2>&1 &
      guard=$!; disown "$guard" 2>/dev/null
    fi
    open -g "$url" >/dev/null 2>&1 || err "could not open the browser; open this URL yourself: $url"
    say "signing in in a background browser tab (up to ${TIMEOUT}s; the browser comes forward after ${SIGNIN_GRACE}s if Microsoft needs you)"
  else
    open "$url" >/dev/null 2>&1 || err "could not open the browser; open this URL yourself: $url"
    say "waiting for the Microsoft sign-in in your browser (up to ${TIMEOUT}s)"
  fi

  i=0
  while :; do
    if log_since "$offset" | grep -q 'Tunnel is up and running'; then break; fi
    if [ "$KEEP_FOCUS" = 1 ] && [ "$i" -eq "$SIGNIN_GRACE" ]; then
      stop_guard
      b=$(default_browser)
      if [ -n "$b" ] && open -b "$b" >/dev/null 2>&1; then
        say "not connected yet: Microsoft needs you to sign in; switched to the browser ($b)"
      else
        open "$url" >/dev/null 2>&1
        say "not connected yet: Microsoft needs you to sign in; opened the browser"
      fi
    fi
    if ! running; then
      stop_guard
      err "openfortivpn stopped before the tunnel came up"
      show_log_tail "$offset"; return 1
    fi
    if [ "$i" -ge "$TIMEOUT" ]; then
      stop_guard
      err "timed out after ${TIMEOUT}s waiting for the tunnel; stopping"
      show_log_tail "$offset"; stop_daemon; return 1
    fi
    sleep 1; i=$((i + 1))
  done
  stop_guard

  i=0
  while [ "$i" -lt 10 ]; do
    if reachable; then
      say "connected ($(ppp_iface)); $PROBE_HOST reachable"
      [ -d "$FORTICLIENT_APP" ] && say "note: FortiClient will keep showing \"Disconnected\": this tunnel is openfortivpn's, not FortiClient's. Don't press Connect there while it's up."
      return 0
    fi
    sleep 1; i=$((i + 1))
  done
  err "tunnel is up ($(ppp_iface)) but $PROBE_HOST is unreachable: check DNS (setup/vpn.md → Troubleshooting)"
  return 2
}

cmd_down() {
  if ! running; then say "already disconnected"; return 0; fi
  if ! stop_daemon; then
    err "could not stop openfortivpn (was it started outside 'vpn up'?)"
    return 1
  fi
  say "disconnected"
}

cmd_log() {
  if [ -r "$LOG" ]; then tail -n 40 "$LOG"; else err "log $LOG is not readable"; return 1; fi
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  check) cmd_check ;;
  log) cmd_log ;;
  installed) cmd_installed ;;
  *) echo "usage: vpn up|down|status|check|log|installed" >&2; exit 64 ;;
esac
